# Meta WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE # Permanent access token from Meta Business > System Users > Generate Token
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID # Phone Number ID from Meta App > WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=YOUR_VERIFY_TOKEN # Any string you choose (e.g. "myverifytoken123") - used to verify webhook

# AI Model (OpenRouter or OpenAI-compatible)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY # API key from openrouter.ai (or use OPENAI_API_KEY if using OpenAI directly)
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free  # Model to use via OpenRouter

# Supabase
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL # Supabase project URL (e.g. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# App Config
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

